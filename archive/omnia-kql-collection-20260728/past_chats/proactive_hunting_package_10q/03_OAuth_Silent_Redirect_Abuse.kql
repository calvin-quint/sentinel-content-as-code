// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1550.001 + T1566.002 - OAuth redirect abuse (Microsoft DCU June 2026 pattern)
// Look for new admin consent grants where the consenting account != the app publisher
// Cross-reference with new service principals created in the last 30 days
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName in (
    "Consent to application",
    "Add app role assignment to service principal",
    "Add delegated permission grant"
)
| extend ConsentedBy = tostring(InitiatedBy.user.userPrincipalName)
| extend AppDisplayName = tostring(TargetResources[0].displayName)
| extend AppId = tostring(TargetResources[0].id)
| extend GrantedPermissions = tostring(TargetResources[0].modifiedProperties)
| where isnotempty(ConsentedBy)
| summarize
    ConsentCount  = count(),
    UniqueApps    = dcount(AppDisplayName),
    AppList       = make_set(AppDisplayName),
    FirstConsent  = min(TimeGenerated),
    LastConsent   = max(TimeGenerated)
    by ConsentedBy
| order by ConsentCount desc
