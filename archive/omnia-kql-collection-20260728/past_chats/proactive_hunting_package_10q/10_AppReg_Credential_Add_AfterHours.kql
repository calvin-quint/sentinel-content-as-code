// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1098.001 - Additional Cloud Credentials on App Registration
// Hypothesis: attacker added credential to app registration outside business hours
// Admin accounts follow username.admin@op.omniapartners.com format
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName in (
    "Add service principal credentials",
    "Update application – Certificates and secrets management"
)
| extend Actor = tostring(InitiatedBy.user.userPrincipalName)
| extend AppName = tostring(TargetResources[0].displayName)
| extend Hour = hourofday(TimeGenerated)
| extend DayOfWeek = dayofweek(TimeGenerated)
// Flag operations outside 7AM-7PM local (UTC-5) and on weekends
| where Hour < 12 or Hour > 24  // UTC 12-24 = 7AM-7PM CDT
    or DayOfWeek == 0d or DayOfWeek == 6d  // Sunday or Saturday
| where Actor !endswith ".admin@op.omniapartners.com"
| project TimeGenerated, Actor, AppName, OperationName, Hour, DayOfWeek,
          tostring(TargetResources)
| order by TimeGenerated desc
