// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1528 - Device code phishing via PhaaS (EvilTokens/Storm-2372 TTPs)
// Hypothesis: users received device code lures and some completed the auth flow
// Hunt window: 30 days to catch slow-burn dwell
let SuspectSubjects = dynamic([
    "salary", "bonus", "payroll", "benefit", "voicemail",
    "shared document", "docusign", "invoice", "onedrive", "verify"
]);
let DeviceCodeAuths =
    SigninLogs
    | where TimeGenerated > ago(30d)
    | where AuthenticationProtocol == "deviceCode"
    | where ResultType == 0
    | where not(NetworkLocationDetails has "namedLocation")
    | project UPN = UserPrincipalName, DCTime = TimeGenerated,
              DCIP = IPAddress, DCCountry = tostring(LocationDetails.countryOrRegion),
              DCDevice = tostring(DeviceDetail.displayName),
              DCUserAgent = UserAgent;
EmailEvents
| where Timestamp > ago(30d)
| where EmailDirection == "Inbound"
| extend SubjectLower = tolower(Subject)
| where SubjectLower has_any (SuspectSubjects)
| project EmailTime = Timestamp, Recipient = RecipientEmailAddress, Subject
| join kind=inner DeviceCodeAuths on $left.Recipient == $right.UPN
| where DCTime between (EmailTime .. (EmailTime + 48h))
| project EmailTime, DCTime, Recipient, Subject, DCIP, DCCountry, DCDevice, DCUserAgent
| order by EmailTime desc
