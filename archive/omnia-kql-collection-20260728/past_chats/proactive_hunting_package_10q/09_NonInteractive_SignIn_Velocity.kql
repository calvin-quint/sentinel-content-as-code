// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1550.001 - Token replay statistical anomaly
// Baseline: >10 non-interactive sign-ins from a single IP within 1 hour = hunt candidate
// Named location IPs (12.55.65.6) excluded to suppress Franklin office noise
SigninLogs
| where TimeGenerated > ago(7d)
| where IsInteractive == false
| where ResultType == 0
| where IPAddress != "12.55.65.6"
| where not(NetworkLocationDetails has "namedLocation")
| summarize
    NISCount   = count(),
    UniqueUPNs = dcount(UserPrincipalName),
    UPNList    = make_set(UserPrincipalName),
    FirstSeen  = min(TimeGenerated),
    LastSeen   = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 1h)
| where NISCount > 10
| where UniqueUPNs > 1
| order by NISCount desc
