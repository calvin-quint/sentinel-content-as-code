// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1027 - Obfuscated Files: HTML/SVG smuggling (Q1 2026 mega-campaign pattern)
// No body URLs to detonate; Safe Links has no visibility; hard-delete required
let SuspectSubjects = dynamic([
    "invoice", "payment", "wire", "transfer", "remittance",
    "statement", "purchase order", "contract", "agreement",
    "notification", "alert", "action required", "urgent"
]);
EmailEvents
| where Timestamp > ago(30d)
| where EmailDirection == "Inbound"
| where AttachmentCount > 0
| join kind=inner EmailAttachmentInfo on NetworkMessageId
| where FileType in~ ("html", "htm", "svg")
| extend SubjectLower = tolower(Subject)
| where SubjectLower has_any (SuspectSubjects)
| project Timestamp, SenderFromAddress, RecipientEmailAddress,
          Subject, FileName, FileType, SHA256,
          DeliveryAction, NetworkMessageId
| order by Timestamp desc
