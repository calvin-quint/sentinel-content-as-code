// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1566.002 - Spearphishing via QR code lure
// UrlLocation == "QRCode" is MDO's native tag for QR-embedded URLs
// Hunt: last 30 days, scope to inbound, surface domains and click-through
EmailEvents
| where Timestamp > ago(30d)
| where EmailDirection == "Inbound"
| join kind=inner EmailUrlInfo on NetworkMessageId
| where UrlLocation == "QRCode"
| extend QRDomain = tostring(parse_url(Url).Host)
| summarize
    EmailCount      = dcount(NetworkMessageId),
    UniqueRecipients = dcount(RecipientEmailAddress),
    UniqueQRDomains = dcount(QRDomain),
    DomainList      = make_set(QRDomain),
    FirstSeen       = min(Timestamp),
    LastSeen        = max(Timestamp)
| order by EmailCount desc

// Follow-up: who clicked a QR-code-delivered URL?
// UrlLocation filter joins to click events via URL match
let QRUrls =
    EmailEvents
    | where Timestamp > ago(30d)
    | where EmailDirection == "Inbound"
    | join kind=inner EmailUrlInfo on NetworkMessageId
    | where UrlLocation == "QRCode"
    | project QRUrl = Url, Recipient = RecipientEmailAddress, EmailTime = Timestamp;
UrlClickEvents
| where Timestamp > ago(30d)
| join kind=inner QRUrls on $left.Url == $right.QRUrl
| where AccountUpn == Recipient
| project Timestamp, AccountUpn, Url, IsClickedThrough, EmailTime
| order by Timestamp desc
