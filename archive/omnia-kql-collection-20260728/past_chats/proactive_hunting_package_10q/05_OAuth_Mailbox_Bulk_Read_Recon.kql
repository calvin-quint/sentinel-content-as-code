// Source: chat "Proactive threat hunting queries and techniques" (2026-06-29)
// ATT&CK: T1114 - Email Collection via Graph API (GraphRunner / AzureHound recon pattern)
// Hunt for apps making repeated mailFolders/messages read calls across multiple users
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(14d)
| where RequestUri has_any ("/messages", "/mailFolders", "/inbox/messages")
| where RequestMethod == "GET"
| summarize
    CallCount      = count(),
    UniqueUsers    = dcount(UserId),
    UniqueIPs      = dcount(IPAddress),
    IPList         = make_set(IPAddress),
    FirstCall      = min(TimeGenerated),
    LastCall       = max(TimeGenerated)
    by AppId
| where CallCount > 50
| where UniqueUsers > 1
| order by CallCount desc
