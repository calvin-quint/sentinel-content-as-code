// Source: chat "Security investigation checklist" / IR-2026-004 (2026-07-24)
// Entity-type gotcha: AlertEvidence joined on DeviceName misses User/Account-entity alerts (DCSync, DFSCoerce)

// Narrow (misses credential-based alerts):
AlertEvidence
| where DeviceName in ("<host1>", "<host2>")
| join kind=inner AlertInfo on AlertId
| project Timestamp, AlertId, Title, Category, Severity, ServiceSource, DetectionSource, DeviceName, AccountName, EntityType
| order by Timestamp desc

// Broader net - searches full entity blob, catches User/Account-type alerts the above misses:
SecurityAlert
| where TimeGenerated > ago(9d)
| where Entities has_any ("<host1>", "<host2>")
    or ExtendedProperties has_any ("<host1>", "<host2>")
| project TimeGenerated, AlertName, AlertSeverity, Status, Description, ProductName, Entities, ExtendedProperties
| order by TimeGenerated desc

SecurityIncident
| where TimeGenerated > ago(9d)
| where Entities has_any ("<host1>", "<host2>")
| project TimeGenerated, IncidentNumber, Title, Severity, Status, Owner, Classification, Entities
| order by TimeGenerated desc

// DCSync-specific pull:
SecurityAlert
| where AlertName == "Suspected DCSync attack (replication of directory services)"
| project TimeGenerated, AlertName, AlertSeverity, Status, Entities, ExtendedProperties
| order by TimeGenerated asc
