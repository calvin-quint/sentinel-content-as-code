let BlockTime = datetime(2026-07-21T22:08:00); // replace with confirmed isolation timestamp from Step 1
let LookbackStart = BlockTime - 4h;
let ProcActivity =
    DeviceProcessEvents
    | where Timestamp between (LookbackStart .. BlockTime)
    | where DeviceName contains "1337"
    | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, EventType = "Process";
let NetActivity =
    DeviceNetworkEvents
    | where Timestamp between (LookbackStart .. BlockTime)
    | where DeviceName contains "1337"
    | project Timestamp, DeviceName, AccountName = InitiatingProcessAccountName, FileName = InitiatingProcessFileName,
              ProcessCommandLine = strcat(tostring(RemoteIP), ":", tostring(RemotePort), " ", tostring(RemoteUrl)), InitiatingProcessFileName, EventType = "Network";
let LogonActivity =
    DeviceLogonEvents
    | where Timestamp between (LookbackStart .. BlockTime)
    | where DeviceName contains "1337"
    | project Timestamp, DeviceName, AccountName, FileName = LogonType, ProcessCommandLine = strcat("RemoteIP: ", tostring(RemoteIP)), InitiatingProcessFileName = "", EventType = "Logon";
ProcActivity
| union NetActivity
| union LogonActivity
| order by Timestamp asc
