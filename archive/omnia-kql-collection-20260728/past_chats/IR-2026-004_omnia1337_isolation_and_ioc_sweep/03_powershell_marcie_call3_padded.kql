// Marcie - Call 3 (padded, Jul 21)
DeviceProcessEvents
| where Timestamp between (datetime(2026-07-21T20:02:22) .. datetime(2026-07-21T20:21:42))
| where DeviceName contains "1272"
| where FileName in~ ("powershell.exe", "pwsh.exe")
| extend InWindow = Timestamp between (datetime(2026-07-21T20:07:22) .. datetime(2026-07-21T20:16:42))
| extend SecondsFromStart = datetime_diff('second', Timestamp, datetime(2026-07-21T20:07:22))
| extend SecondsFromEnd   = datetime_diff('second', Timestamp, datetime(2026-07-21T20:16:42))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InWindow, SecondsFromStart, SecondsFromEnd
| order by Timestamp asc
