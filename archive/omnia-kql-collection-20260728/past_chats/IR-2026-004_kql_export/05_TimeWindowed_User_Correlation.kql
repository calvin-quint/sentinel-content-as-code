// Marcie (omnia-1272) — Session 1 window: Jul 20, 12:40-13:10 PM
let StartTime = datetime(2026-07-20 12:40:00);
let EndTime = datetime(2026-07-20 13:10:00);
DeviceProcessEvents
| where DeviceName contains "1272"
| where Timestamp between (StartTime .. EndTime)
| where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe" or FileName =~ "msra.exe"
    or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Marcie (omnia-1272) — Session 2 window: Jul 21, 15:00-15:30 PM
let StartTime = datetime(2026-07-21 15:00:00);
let EndTime = datetime(2026-07-21 15:30:00);
DeviceProcessEvents
| where DeviceName contains "1272"
| where Timestamp between (StartTime .. EndTime)
| where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe" or FileName =~ "msra.exe"
    or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Gabriella (omnia-1294) — session window: Jul 20, 16:10-16:30 PM
// NOTE: exact window not fully confirmed - verify against original alert/incident timestamp before trusting results
let StartTime = datetime(2026-07-20 16:10:00);
let EndTime = datetime(2026-07-20 16:30:00);
DeviceProcessEvents
| where DeviceName contains "1294"
| where Timestamp between (StartTime .. EndTime)
| where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe" or FileName =~ "msra.exe"
    or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Domain Controllers — coercion sweep window: Jul 21, 16:35-17:15
let StartTime = datetime(2026-07-21 16:35:00);
let EndTime = datetime(2026-07-21 17:15:00);
DeviceProcessEvents
| where DeviceName has_any ("hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where Timestamp between (StartTime .. EndTime)
| where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe"
    or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Correlation query — all windows, all devices, unioned with confirmed attack-chain processes
let MarcieS1Start = datetime(2026-07-20 12:40:00);
let MarcieS1End   = datetime(2026-07-20 13:10:00);
let MarcieS2Start = datetime(2026-07-21 15:00:00);
let MarcieS2End   = datetime(2026-07-21 15:30:00);
let GabbyStart    = datetime(2026-07-20 16:10:00);
let GabbyEnd      = datetime(2026-07-20 16:30:00);
let DCStart       = datetime(2026-07-21 16:35:00);
let DCEnd         = datetime(2026-07-21 17:15:00);
let ServiceActivity = DeviceProcessEvents
    | where DeviceName has_any ("omnia-1272", "omnia-1294", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
    | where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe" or FileName =~ "msra.exe"
        or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
    | extend Window = case(
        DeviceName contains "1272" and Timestamp between (MarcieS1Start .. MarcieS1End), "Marcie-Session1",
        DeviceName contains "1272" and Timestamp between (MarcieS2Start .. MarcieS2End), "Marcie-Session2",
        DeviceName contains "1294" and Timestamp between (GabbyStart .. GabbyEnd), "Gabriella-Session",
        DeviceName has_any ("hqdc01","hqdc02","hqdc03","opclddc01","opclddc02") and Timestamp between (DCStart .. DCEnd), "DC-Coercion-Sweep",
        "Outside-Known-Windows")
    | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, Window, EventType = "ServiceProcess";
let AttackChain = DeviceProcessEvents
    | where DeviceName has_any ("omnia-1272", "omnia-1294")
    | where FileName in~ ("curl.exe","msiexec.exe","vaelix.exe","Ditto.exe","cmd.exe")
    | extend Window = case(
        DeviceName contains "1272" and Timestamp between (MarcieS1Start .. MarcieS1End), "Marcie-Session1",
        DeviceName contains "1272" and Timestamp between (MarcieS2Start .. MarcieS2End), "Marcie-Session2",
        DeviceName contains "1294" and Timestamp between (GabbyStart .. GabbyEnd), "Gabriella-Session",
        "Outside-Known-Windows")
    | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, Window, EventType = "AttackChain";
ServiceActivity
| union AttackChain
| order by Window asc, Timestamp asc
