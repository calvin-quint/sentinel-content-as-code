// Query 1 — Print Spooler activity (process) on all incident-relevant hosts
DeviceProcessEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where FileName =~ "spoolsv.exe"
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Query 1b — Print Spooler network activity
DeviceNetworkEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where InitiatingProcessFileName =~ "spoolsv.exe"
| project Timestamp, DeviceName, RemoteIP, RemotePort, ActionType, InitiatingProcessAccountName
| order by Timestamp asc

// Query 2 — WebClient (WebDAV) and Remote Registry service activity
DeviceProcessEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where FileName =~ "svchost.exe"
| where ProcessCommandLine has_any ("WebClient", "RemoteRegistry")
| project Timestamp, DeviceName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Query 3 — Service registry state changes (Spooler, WebClient, RemoteRegistry, WinRM)
DeviceRegistryEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where RegistryKey has_any (@"Services\Spooler", @"Services\WebClient", @"Services\RemoteRegistry", @"Services\WinRM", @"Services\SessionEnv")
| project Timestamp, DeviceName, ActionType, RegistryKey, RegistryValueName, RegistryValueData, InitiatingProcessFileName
| order by Timestamp asc

// Query 4 — WinRM active session usage (wsmprovhost.exe)
DeviceProcessEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where FileName =~ "wsmprovhost.exe"
| project Timestamp, DeviceName, AccountName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Query 5 — Solicited Remote Assistance invocation (msra.exe)
DeviceProcessEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337")
| where FileName =~ "msra.exe"
| project Timestamp, DeviceName, AccountName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc

// Query 6 — Anonymous logon attempts
DeviceLogonEvents
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
| where AccountName =~ "ANONYMOUS LOGON" or (LogonType == "Network" and isempty(AccountDomain))
| project Timestamp, DeviceName, AccountName, ActionType, RemoteIP, LogonType
| order by Timestamp asc
