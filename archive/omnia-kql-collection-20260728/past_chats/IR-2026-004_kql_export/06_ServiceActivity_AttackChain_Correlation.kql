// Correlation query — ties confirmed service activity (Spooler/WebClient/WinRM/RemoteRegistry)
// to the known compromise timeline in a single view
let CompromiseWindowStart = datetime(2026-07-20 12:00:00);
let CompromiseWindowEnd = datetime(2026-07-21 20:00:00);
let ServiceActivity = DeviceProcessEvents
    | where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337", "hqdc01", "hqdc02", "hqdc03", "opclddc01", "opclddc02")
    | where FileName =~ "spoolsv.exe" or FileName =~ "wsmprovhost.exe" or FileName =~ "msra.exe"
        or (FileName =~ "svchost.exe" and ProcessCommandLine has_any ("WebClient", "RemoteRegistry"))
    | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, EventType = "ServiceProcess";
let CoercionActivity = DeviceProcessEvents
    | where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337")
    | where FileName in~ ("curl.exe","msiexec.exe","vaelix.exe","Ditto.exe","cmd.exe")
    | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, EventType = "AttackChain";
ServiceActivity
| union CoercionActivity
| where Timestamp between (CompromiseWindowStart .. CompromiseWindowEnd)
| order by Timestamp asc
