// Query — RPC/SMB/LDAP/Kerberos traffic from omnia-1272 to Domain Controllers
// NOTE: substitute actual DC IPs before running
DeviceNetworkEvents
| where DeviceName contains "1272"
| where RemotePort in (135, 445, 389, 636, 88)
| where RemoteIP in ("<hqdc01_ip>","<hqdc02_ip>","<hqdc03_ip>","<opclddc01_ip>","<opclddc02_ip>")
| project Timestamp, DeviceName, RemoteIP, RemotePort, ActionType, InitiatingProcessFileName, InitiatingProcessAccountName
| order by Timestamp asc

// Query — full inventory of non-web ports/destinations reached by Marcie's device
DeviceNetworkEvents
| where DeviceName contains "1272"
| where RemotePort !in (443, 80)
| where InitiatingProcessAccountName == "marcie.carpenter"
| summarize Ports=make_set(RemotePort), Destinations=make_set(RemoteIP) by DeviceName

// Query — outbound RDP from omnia-1272
DeviceNetworkEvents
| where DeviceName contains "1272"
| where RemotePort == 3389
| project Timestamp, DeviceName, RemoteIP, RemotePort, ActionType, InitiatingProcessFileName, InitiatingProcessAccountName
| order by Timestamp asc

// Query — all traffic from omnia-1272 to confirmed attacker infrastructure IOC IPs
let AttackerIPs = dynamic([
    "172.86.126.92","172.86.126.250","18.153.106.96",
    "216.155.157.161","161.35.5.12","172.65.164.225"
]);
DeviceNetworkEvents
| where DeviceName contains "1272"
| where RemoteIP in (AttackerIPs)
| project Timestamp, DeviceName, RemoteIP, RemotePort, RemoteUrl, ActionType, InitiatingProcessFileName, InitiatingProcessAccountName
| order by Timestamp asc
