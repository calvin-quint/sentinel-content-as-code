// Source: chat "KQL queries for insider risk and AITM detection" (2026-06-26)
// New credential added to service principal or app registration
// NOTE: query was truncated mid-retrieval in source chat - ActorUPN extend line incomplete
AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName in ("Add service principal credentials", "Update application – Certificates and secrets management")
| extend ActorUPN = tostring(InitiatedBy.user.userPrincipalName)
