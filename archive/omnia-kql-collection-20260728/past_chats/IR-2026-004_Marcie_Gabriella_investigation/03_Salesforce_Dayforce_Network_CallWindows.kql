// Source: chat "Security investigation checklist" (2026-07-24)
// IR-2026-004 - SaaS/business app traffic during confirmed attacker call windows

// Gabriella - Jul 16, 4:05:48-4:26:14 PM CDT
DeviceNetworkEvents
| where DeviceName contains "1294"
| where Timestamp between (datetime(2026-07-16T21:00:48) .. datetime(2026-07-16T21:31:14))
| where RemoteUrl has_any ("salesforce.com", "force.com", "dayforce.com", "dayforcehcm.com", "ceridian.com")
| project Timestamp, DeviceName, RemoteIP, RemoteUrl, RemotePort, InitiatingProcessFileName, InitiatingProcessAccountName
| order by Timestamp asc

