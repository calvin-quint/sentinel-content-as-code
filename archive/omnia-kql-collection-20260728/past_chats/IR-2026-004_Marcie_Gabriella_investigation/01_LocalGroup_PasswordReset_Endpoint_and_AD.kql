// Source: chat "Detecting localgroup and password reset commands on Marcie's device" (2026-07-28)
// IR-2026-004

// 1. Endpoint-side - net localgroup / net user / PS equivalents on Marcie's device
DeviceProcessEvents
| where DeviceName has "1272"
| where FileName in~ ("net.exe", "net1.exe", "powershell.exe", "pwsh.exe", "cmd.exe")
| where ProcessCommandLine has_any (
    "net localgroup",
    "net1 localgroup",
    "net user",
    "net1 user",
    "net accounts",
    "Add-LocalGroupMember",
    "Remove-LocalGroupMember",
    "New-LocalUser",
    "Set-LocalUser",
    "Add-LocalUser",
    "Set-ADAccountPassword",
    "ConvertTo-SecureString"
)
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
| order by Timestamp asc

// 2. AD-side - did a password reset actually land on her account
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID in (4724, 4738, 4723)
// 4724 = reset attempt on account, 4738 = account changed, 4723 = attempt to change own password
| where Computer has_any ("hqdc01", "hqdc02", "opclddc01", "opclddc02")
| where TargetAccount has "carpenter" or TargetAccount has "marcie"
| project TimeGenerated, Computer, EventID, SubjectAccount, TargetAccount
| order by TimeGenerated asc

// 3. Local Administrators / global / universal group membership changes
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID in (4732, 4728, 4756)
// 4732 = added to local group, 4728 = added to global group, 4756 = added to universal group
| where Computer has_any ("1272", "hqdc01", "hqdc02", "opclddc01", "opclddc02")
| project TimeGenerated, Computer, EventID, SubjectAccount, TargetAccount, MemberName
| order by TimeGenerated asc
