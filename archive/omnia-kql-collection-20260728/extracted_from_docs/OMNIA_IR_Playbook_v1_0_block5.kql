// ATT&CK: T1539 - Steal Web Session Cookie
// IssuedIP = where user authenticated (through proxy)
// GraphIP  = where attacker replayed the token
let issuedTokens =
    SigninLogs
    | where TimeGenerated > ago(1d)
    | where isnotempty(UniqueTokenIdentifier)
    | where ResultType == 0
    | project UniqueTokenIdentifier, IssuedIP = IPAddress,
              IssuedCountry = tostring(LocationDetails.countryOrRegion),
              IssuedTime = TimeGenerated, UserPrincipalName,
              IssuedApp = AppDisplayName,
              IssuedDevice = tostring(DeviceDetail.displayName),
              IssuedDeviceTrust = tostring(DeviceDetail.trustType);
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(1d)
| where isnotempty(UniqueTokenId)
| project GraphTime = TimeGenerated, GraphIP = IPAddress,
          RequestUri, UserAgent, UniqueTokenIdentifier = UniqueTokenId,
          GraphRequestMethod = RequestMethod,
          GraphResponseCode = ResponseStatusCode
| join kind=inner issuedTokens on UniqueTokenIdentifier
| where GraphIP != IssuedIP
| extend TimeDelta = GraphTime - IssuedTime
| where TimeDelta between (0min .. 24h)
| project GraphTime, IssuedTime, TimeDelta, UserPrincipalName,
          UniqueTokenIdentifier, IssuedIP, IssuedCountry,
          IssuedApp, IssuedDevice, IssuedDeviceTrust,
          GraphIP, RequestUri, GraphRequestMethod, GraphResponseCode, UserAgent
| order by GraphTime desc
