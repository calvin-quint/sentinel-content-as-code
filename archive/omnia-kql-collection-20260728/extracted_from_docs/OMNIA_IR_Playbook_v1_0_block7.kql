// ATT&CK: T1137 - Office Application Startup (Inbox Rule)
CloudAppEvents
| where ActionType == "New-InboxRule"
| extend RuleConditions = tostring(RawEventData.Parameters)
| where RuleConditions !contains "SubjectContains"
    and RuleConditions !contains "From"
    and RuleConditions !contains "BodyContains"
| project Timestamp, AccountDisplayName, AccountObjectId,
          RuleConditions, RawEventData
| order by Timestamp desc
