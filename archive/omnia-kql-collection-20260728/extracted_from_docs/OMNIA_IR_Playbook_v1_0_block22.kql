// Internal recipients who clicked
let InternalSends =
    EmailEvents
    | where SenderFromAddress =~ "<upn>"
    | where Timestamp > ago(7d)
    | where EmailDirection in ("Inbound", "IntraOrg")
    | project NetworkMessageId, RecipientEmailAddress, Subject, Timestamp;
UrlClickEvents
| where Timestamp > ago(7d)
| join kind=inner InternalSends on NetworkMessageId
| project Timestamp, RecipientEmailAddress, Subject, Url, IsClickedThrough, AccountUpn
| order by Timestamp desc
