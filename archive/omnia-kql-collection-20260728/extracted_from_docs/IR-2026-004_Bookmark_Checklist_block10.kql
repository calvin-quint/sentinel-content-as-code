let ExfilDomains = dynamic(["sendspace.com","anonfiles.com","gofile.io","transfer.sh","file.io"]);
DeviceNetworkEvents
| where Timestamp > ago(30d)
| where DeviceName has_any ("omnia-1272", "omnia-1294", "omnia-1337")
| where RemoteUrl has_any (ExfilDomains)
| project Timestamp, DeviceName, RemoteUrl, RemoteIP, InitiatingProcessFileName
| order by Timestamp asc
