// ATT&CK: TI enrichment — STIX ThreatIntelIndicators (NOT ThreatIntelligenceIndicator)
let TIIndicators =
    ThreatIntelIndicators
    | where IsDeleted == false
    | where ValidUntil > now()
    | where ObservableKey == "network-traffic:dst_ref.type = 'ipv4-addr' AND network-traffic:dst_ref.value"
    | project TI_IP = ObservableValue, Confidence, Description, ValidUntil;
DeviceNetworkEvents
| where Timestamp > ago(24h)
| join kind=inner TIIndicators on $left.RemoteIP == $right.TI_IP
| project Timestamp, DeviceName, InitiatingProcessAccountName,
          RemoteIP, RemotePort, TI_IP, Confidence, Description
| order by Timestamp desc
