// Source: "Wacatac malware detection and remediation" session (past chat)
// Purpose: confirm whether vaelix.exe's SMB (445) and RPC (135) hits on
// internal hosts are the same ~71 hosts (SMB probe + RPC follow-up) rather
// than 30 additional distinct targets.

DeviceNetworkEvents
| where DeviceName == "omnia-1272.op.omniapartners.com"
| where InitiatingProcessFileName =~ "vaelix.exe"
| where RemotePort in (445, 135)
| summarize Ports = make_set(RemotePort) by RemoteIP
| summarize BothPorts = countif(array_length(Ports) == 2), SmbOnly = countif(array_length(Ports) == 1 and Ports[0] == 445), RpcOnly = countif(array_length(Ports) == 1 and Ports[0] == 135)

// Result confirmed: vaelix.exe touched port 445 (SMB) on 71 distinct internal
// hosts — the actual blast-radius scan footprint. 30 RPC (135) hits are a
// subset of those same hosts, not additional targets. Port distribution
// summary for the report:
//   445 (SMB)        71 hits / 71 hosts  — internal scan
//   135 (RPC)        30 hits / 30 hosts  — internal scan (subset of above)
//   389 (LDAP)        6 hits /  6 hosts  — AD query (3 DCs)
//   636 (LDAPS)       5 hits /  5 hosts  — AD query (3 DCs)
//   53  (DNS)         5 hits /  3 hosts  — resolution
//   9001-9026 (C2)   26 hits / 26 hosts  — C2 to 18.153.106.96, sustained session
