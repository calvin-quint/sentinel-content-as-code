// Source: "Security risks of directory whitelisting" + "Sentinel detection
// rules for missed alerts" sessions (past chats)
// Bug fixes applied: real CSV columns are Name/Filename/InstallationPaths
// (not ToolName/ProcessName); join is case-sensitive by default so both
// sides must be normalized to lowercase; old raw.githubusercontent.com URL
// 404s, replaced with https://lolrmm.io/api/rmm_tools.csv directly.

// --- Sanity check: confirm the parser extracts tool names correctly BEFORE trusting the join ---
let LOLRMM = externaldata(Name:string, Category:string, Description:string,
    Author:string, Created:string, LastModified:string, Website:string,
    Filename:string, OriginalFileName:string, PEDescription:string,
    Product:string, Privileges:string, Free:string, Verification:string,
    SupportedOS:string, Capabilities:string, Vulnerabilities:string,
    InstallationPaths:string, Artifacts:string, Detections:string,
    References:string, Acknowledgement:string)
    [@"https://lolrmm.io/api/rmm_tools.csv"]
    with (format="csv", ignoreFirstRecord=True);
LOLRMM
| extend CombinedNames = strcat(Filename, ", ", InstallationPaths)
| mv-expand Token = split(CombinedNames, ",")
| extend Token = trim(@"[\s\*]+", tostring(Token))
| extend Token = tolower(extract(@"([^\\\/]+\.exe)$", 1, Token))
| where isnotempty(Token)
| distinct Token, Name
| where Name has "Datto"   // confirm Datto's exe names actually get extracted

// --- Fixed main query: unsanctioned RMM network connections ---
let LOLRMM2 = externaldata(Name:string, Category:string, Description:string,
    Author:string, Created:string, LastModified:string, Website:string,
    Filename:string, OriginalFileName:string, PEDescription:string,
    Product:string, Privileges:string, Free:string, Verification:string,
    SupportedOS:string, Capabilities:string, Vulnerabilities:string,
    InstallationPaths:string, Artifacts:string, Detections:string,
    References:string, Acknowledgement:string)
    [@"https://lolrmm.io/api/rmm_tools.csv"]
    with (format="csv", ignoreFirstRecord=True);
let AllowedRMM_Name = dynamic(["Atera"]);
let ParsedExecutables =
    LOLRMM2
    | where Name !in (AllowedRMM_Name)
    | extend CombinedNames = strcat(Filename, ", ", InstallationPaths)
    | mv-expand Token = split(CombinedNames, ",")
    | extend Token = trim(@"[\s\*]+", tostring(Token))
    | extend Token = tolower(extract(@"([^\\\/]+\.exe)$", 1, Token))
    | where isnotempty(Token)
    | distinct Token, Name;
DeviceNetworkEvents
| where Timestamp > ago(30d)
| where ActionType == "ConnectionSuccess"
| extend ProcLower = tolower(InitiatingProcessFileName)
| join kind=inner ParsedExecutables on $left.ProcLower == $right.Token
| project Timestamp, DeviceName, InitiatingProcessFileName, Name,
          InitiatingProcessAccountName, RemoteIP, RemoteUrl, RemotePort
| order by Timestamp desc

// This hunt surfaced (during the OMNIA investigation this query was built for):
// TeamViewer (SYSTEM-context, persistent, 115 connections),
// GoToAssist (4 devices, 362 connections),
// Quick Assist on gabriella.triano and marcie.carpenter — confirmed
//   unauthorized since internal IT does not use Quick Assist (this is the
//   finding that led directly into IR-2026-004),
// LogMeIn (1 device, low volume).
// Datto RMM (aemagent.exe, cagservice.exe) found running under SYSTEM on
// opcldtabclub01-04 and opcldlogicmon — separately tracked, connecting to
// "vidal" tenant infrastructure, not OMNIA/Critical Start/InterWorks.
