// Source: "Sentinel detection rules for missed alerts" session (past chat)
// ATT&CK: T1219 - Remote Access Software (unsanctioned RMM detection)
// Pulls the LOLRMM catalog directly via externaldata — no watchlist import
// required. Source confirmed live: https://lolrmm.io/api/rmm_tools.csv
// (the raw.githubusercontent.com path from an earlier draft 404s — retired)
// Exclusions layered in after live data review: 95% of initial hits were
// Splashtop noise (missing process names in SanctionedRMM); CentraStage
// added as approved for Tableau infrastructure monitoring.

let SanctionedRMM = dynamic(["ateraagent.exe", "agentexecutor.exe", "agentpackagesystemtools.exe",
                              "splashtop.exe", "srserver.exe", "streamer.exe", "srmanager.exe"]);
let LOLRMMProcesses =
    externaldata (Name:string, Category:string, Description:string, Author:string, Created:string,
                   LastModified:string, Website:string, Filename:string, OriginalFileName:string,
                   PEDescription:string, Product:string, Privileges:string, Free:string,
                   Verification:string, SupportedOS:string, Capabilities:string, Vulnerabilities:string,
                   InstallationPaths:string, Artifacts:string, Detections:string, References:string,
                   Acknowledgement:string)
        [h'https://lolrmm.io/api/rmm_tools.csv']
        with (format="csv", ignoreFirstRecord=true)
    | project ToolName = Name, RawNames = strcat(Filename, ",", InstallationPaths)
    | mv-expand RawEntry = split(RawNames, ",")
    | extend ProcEntry = tolower(tostring(split(trim(@"[\s\*]+", tostring(RawEntry)), @"\")[-1]))
    | where ProcEntry endswith ".exe"
    | distinct ProcEntry, ToolName;
DeviceProcessEvents
| where Timestamp > ago(1d)
| extend ProcName = tolower(FileName)
| where ProcName !in (SanctionedRMM)
| join kind=inner LOLRMMProcesses on $left.ProcName == $right.ProcEntry
| where ToolName !contains "Splashtop"
| where ToolName !contains "CentraStage"
| project TimeGenerated = Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine,
          InitiatingProcessFileName, InitiatingProcessParentFileName, ToolName
| order by TimeGenerated desc
