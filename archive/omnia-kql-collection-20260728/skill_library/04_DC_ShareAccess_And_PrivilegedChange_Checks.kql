// Source: "Chaos ransomware group attribution" session (past chat)
// Bookmark Checklist Section 11b/11c additions (not yet synced to the
// canonical project checklist file as of this recovery).

// --- 11b: Share access on the DCs (Event 5140) ---
// Cross-reference any hits here against DeviceNetworkEvents for
// Ditto.exe/vaelix.exe process association on the source device — if the
// source is Ditto/vaelix rather than a separate Impacket process, that
// confirms coercion+relay capability is built into the malware itself.
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID == 5140
| where Computer has_any ("hqdc01","hqdc02","hqdc03","opclddc01","opclddc02")
| project TimeGenerated, Computer, Account, IpAddress, ShareName
| order by TimeGenerated asc

// --- 11c: Privileged account or GPO change check ---
// Downstream evidence of successful exploitation, independent of DCSync.
// EventID 4728 = added to privileged group, 4732 = added to local group,
// 4756 = added to universal group, 5136 = directory object/GPO modified.
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID in (4728, 4732, 4756, 5136)
| where Computer has_any ("hqdc01","hqdc02","hqdc03","opclddc01","opclddc02")
| where TimeGenerated > datetime(2026-07-20T00:00:00)  // after coercion window began
| project TimeGenerated, Computer, SubjectAccount, TargetAccount, ObjectName
| order by TimeGenerated asc
