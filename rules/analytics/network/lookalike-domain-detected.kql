// Title: Lookalike / Typosquat Domain Detected
// MITRE ATT&CK: Resource Development - Acquire/Compromise Infrastructure: Domains
//               (T1583.001 / T1584.001)
// Detects: Domains queried by the environment that closely resemble a maintained
//          watchlist of brand/vendor domains - classic typosquat/lookalike
//          patterns: character insertion, hyphenation, or a numeric suffix/prefix
//          around the brand name. KQL has no native edit-distance function, so this
//          uses substring containment + hyphen/suffix regex patterns instead of
//          true Levenshtein distance - good enough to catch the common cases
//          without a plugin.
// Data source: ASIM DNS normalization (_Im_Dns) - source-agnostic, works against
//              Cloudflare Gateway logs, Windows DNS analytics, or any connector
//              mapped to the ASIM DNS schema. Swap _Im_Dns for the actual table
//              (e.g. CommonSecurityLog, DeviceNetworkEvents) if ASIM parsers
//              aren't deployed in the workspace.
// Watchlist required: "BrandDomains" - one column DomainName, seeded with the
//              legitimate corporate/vendor domains to protect.
// Entity mapping: DNS → DomainName → DnsQuery

let brandRoots = toscalar(
    _GetWatchlist("BrandDomains")
    | project BrandRoot = tostring(split(DomainName, ".")[0])
    | summarize make_list(BrandRoot)
);
_Im_Dns(starttime = ago(1d), endtime = now())
| where isnotempty(DnsQuery)
| extend QueryRoot = tolower(DnsQuery)
| extend QueryLabel = tostring(split(QueryRoot, ".")[0])
| mv-apply BrandRoot = brandRoots to typeof(string) on (
    where QueryLabel has BrandRoot
       or QueryLabel matches regex strcat(BrandRoot, @"[-0-9]{1,4}$")   // brand + hyphen/number suffix
       or QueryLabel matches regex strcat(@"^[-0-9]{1,4}", BrandRoot)  // hyphen/number prefix + brand
)
| where QueryRoot !endswith strcat(BrandRoot, ".com")          // drop legit exact matches of the real brand
    and QueryLabel != BrandRoot                                // drop exact label matches (real domain)
| summarize FirstSeen = min(TimeGenerated), QueryCount = count(), Devices = make_set(SrcIpAddr, 10)
    by DnsQuery, BrandRoot
| order by FirstSeen desc
