// Author: Calvin Quint
// GitHub: https://github.com/calvin-quint/docs/blob/main/01-detection-engineering/kql/data-exfiltration/versions/personal-cloud-storage-exfiltration/v5.kql
// v5 — reintroduces org-source / non-org-target domain filtering on top of
// v4's Purview DLP join (see ../README.md for lineage). MITRE ATT&CK:
// Exfiltration to Cloud Storage (T1567.002). Missing the final version's
// destination risk-tiering (Critical/High/Medium/Low RiskScore) and cheap
// string pre-filters before parse_json. Superseded by
// ../../personal_cloud_storage_exfiltration.kql.
CloudAppEvents
| where ActionType in (
    "FileSyncUploadedFull",
    "FileUploaded",
    "FileUploadedToCloud",
    "FileUploadedPartial",
    "TeamsMeetingRecordingUploaded"
)
| extend Raw = parse_json(RawEventData)
| where
      tostring(Raw.OriginatingDomain) contains "centralparticipant"
   or tostring(Raw.OriginatingDomain) contains "sharepoint"
   or tostring(Raw.OriginatingDomain) contains "microsoft"
   or tostring(Raw.OriginatingDomain) contains "office"
   or tostring(Raw.OriginatingDomain) contains "contoso"
| where
      tostring(Raw.TargetDomain) !contains "centralparticipant"
   and tostring(Raw.TargetDomain) !contains "sharepoint"
   and tostring(Raw.TargetDomain) !contains "microsoft"
   and tostring(Raw.TargetDomain) !contains "office"
   and tostring(Raw.TargetDomain) !contains "contoso"
| extend
    UserUPN              = tolower(iff(AccountId contains "@", AccountId, AccountDisplayName)),
    DeviceName           = tostring(Raw.DeviceName),
    TargetDomain         = tostring(Raw.TargetDomain),
    RawTargetUrl         = tostring(Raw.TargetUrl),
    RawOriginatingDomain = tostring(Raw.OriginatingDomain)
| where isnotempty(Raw.SensitiveInfoTypeData)
| extend DLP = Raw.SensitiveInfoTypeData
| where DLP != "" and DLP != "[]"
| mv-expand DLP
| extend
    SensitiveType       = tostring(DLP.SensitiveInfoTypeName),
    SensitiveCount      = toint(DLP.Count),
    SensitiveConfidence = toint(DLP.Confidence)
| where SensitiveType has_any (
    "Social",
    "Credit",
    "Address",
    "Bank",
    "Medical",
    "License",
    "Credential"
)
| summarize
    FileCount           = dcount(tostring(ObjectId)),
    SensitiveHitCount   = sum(SensitiveCount),
    MaxConfidence       = max(SensitiveConfidence),
    SensitiveTypes      = make_set(SensitiveType),
    Files               = make_set(ObjectName),
    FileExtensions      = make_set(tostring(Raw.FileExtension)),
    FileSizes           = make_set(toint(Raw.FileSize)),
    TargetUrls          = make_set(RawTargetUrl),
    OriginatingDomains  = make_set(RawOriginatingDomain),
    Apps                = make_set(Application),
    IPs                 = make_set(IPAddress),
    Devices             = make_set(DeviceType),
    FirstSeen           = min(TimeGenerated),
    LastSeen            = max(TimeGenerated)
by
    UserUPN,
    DeviceName,
    TargetDomain
| where SensitiveHitCount >= 1
| join kind=leftouter (
    OfficeActivity
    | where Operation == "DlpRuleMatch"
    | project
        OA_UPN         = tolower(UserId),
        DlpRuleName    = tostring(column_ifexists("DlpRuleName", "")),
        DlpPolicyName  = tostring(column_ifexists("DlpPolicyName", "")),
        OfficeWorkload = tostring(column_ifexists("OfficeWorkload", ""))
) on $left.UserUPN == $right.OA_UPN
| summarize
    FileCount          = any(FileCount),
    SensitiveHitCount  = any(SensitiveHitCount),
    MaxConfidence      = any(MaxConfidence),
    SensitiveTypes     = any(SensitiveTypes),
    Files              = any(Files),
    FileExtensions     = any(FileExtensions),
    FileSizes          = any(FileSizes),
    TargetUrls         = any(TargetUrls),
    OriginatingDomains = any(OriginatingDomains),
    Apps               = any(Apps),
    IPs                = any(IPs),
    Devices            = any(Devices),
    OfficeWorkloads    = make_set(OfficeWorkload),
    DlpRules           = make_set(DlpRuleName),
    DlpPolicies        = make_set(DlpPolicyName),
    FirstSeen          = min(FirstSeen),
    LastSeen           = max(LastSeen)
by
    UserUPN,
    DeviceName,
    TargetDomain
| order by SensitiveHitCount desc