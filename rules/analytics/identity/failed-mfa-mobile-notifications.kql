// Author: Calvin Quint
// GitHub: https://github.com/calvin-quint/docs/blob/main/01-detection-engineering/kql/identity/failed_mfa_mobile_notifications.kql
// Failed MFA Mobile Push Notification (Correct Password, Non-US)
// MITRE ATT&CK: Credential Access — Multi-Factor Authentication Request
//               Generation (T1621)
// Detects: The password step succeeding but the mobile app push notification
//          being denied/failing, from a non-US location — the signature of
//          an attacker with a valid stolen password triggering MFA push
//          fatigue/bombing while the real user declines the prompt.
// Entity mapping: Account → UPN → UserPrincipalName
SigninLogs
| where AuthenticationRequirement == "multiFactorAuthentication"
| where Status !contains "requirement satisfied"
| where AuthenticationDetails contains "Correct password"
| where AuthenticationDetails contains '"Mobile app notification","succeeded":false'
| where Status !contains "success"
| where Location != "US"
