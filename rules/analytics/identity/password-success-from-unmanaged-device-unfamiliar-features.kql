// Author: Calvin Quint
// GitHub: https://github.com/calvin-quint/docs/blob/main/01-detection-engineering/kql/identity/password_success_from_unmanaged_device_unfamiliar_features.kql
// Successful Password Sign-in from Unmanaged Device with Unfamiliar Features
// MITRE ATT&CK: Initial Access — Valid Accounts: Cloud Accounts (T1078.004)
// Detects: A correct-password sign-in that succeeds from a device with no
//          Entra device ID (unmanaged/BYOD) while Identity Protection flags
//          "unfamiliarFeatures" risk — an atypical browser/device/location
//          combination for that user. Combination of unmanaged endpoint +
//          anomalous signal is a strong indicator of credential compromise
//          rather than routine BYOD use.
// Entity mapping: Account → UPN → UserPrincipalName
//                 IP      → Address → IPAddress
SigninLogs
| extend AuthDetails = parse_json(AuthenticationDetails)
| mv-expand AuthDetails
| where tostring(AuthDetails.authenticationMethod) == "Password"
| where tostring(AuthDetails.authenticationStepResultDetail) == "Correct password"
| where tostring(AuthDetails.succeeded) == "true"
| extend DeviceId = tostring(DeviceDetail.deviceId)
| where isempty(DeviceId)
| where RiskEventTypes has "unfamiliarFeatures"
| project
    TimeGenerated,
    UserPrincipalName,
    IPAddress,
    AutonomousSystemNumber,
    Location = tostring(LocationDetails.countryOrRegion),
    City = tostring(LocationDetails.city),
    AppDisplayName,
    ConditionalAccessStatus,
    ResultType,
    RiskLevelDuringSignIn,
    RiskEventTypes,
    ClientAppUsed
| order by TimeGenerated desc